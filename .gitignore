# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright
/test-results/
/playwright-report/
/blob-report/

# The pre-database waitlist store. Retired in favour of Postgres; the file is
# kept locally because it is the only surviving copy of the 54 records it holds
# until scripts/db/migrate-ndjson.mjs has been run. Do not delete it before then.
/.data/

# Database backups. These contain real personal data and never enter git.
/backups/

# Lighthouse HTML reports are large; summary.json is committed
/docs/lighthouse/*.html

.vercel
